# Firebase — Firebase Console → Project settings → General → Your apps (Web)
EXPO_PUBLIC_FIREBASE_API_KEY="AIzaSy…"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
EXPO_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"

# MEGA — account credentials
EXPO_PUBLIC_MEGA_EMAIL="you@example.com"
EXPO_PUBLIC_MEGA_PASSWORD='your_mega_password'

# MEGA session cache — optional, skips 10–30s PBKDF2 on device
# Fill above two, run: node scripts/mega-session.js, paste output below
EXPO_PUBLIC_MEGA_SID=
EXPO_PUBLIC_MEGA_MASTER_KEY=
EXPO_PUBLIC_MEGA_ROOT=
